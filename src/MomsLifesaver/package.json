{
  "name": "momslifesaver",
  "main": "index.js",
  "version": "1.0.3",
  "homepage": "https://FilipeLopesPires.github.io/MomsLifesaver",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web --host lan",
    "export:web": "expo export -p web --output-dir dist && rm -rf ../../docs && mkdir -p ../../docs && cp -r dist/. ../../docs/",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "build:android:dev": "eas build --profile development --platform android --local --output ./builds/android-dev.apk",
    "build:android:preview": "eas build --profile preview --platform android --local --output ./builds/android-preview.apk",
    "build:android:prod": "eas build --profile production --platform android --local --output ./builds/android-prod.aab",
    "build:android:prod-apk": "eas build --profile production-apk --platform android --local --output ./builds/android-prod.apk"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.1.0",
    "@react-native-community/slider": "4.5.6",
    "@react-navigation/native": "^7.1.6",
    "expo": "~53.0.0",
    "expo-asset": "~11.1.7",
    "expo-audio": "~0.4.9",
    "expo-constants": "~17.1.8",
    "expo-dev-client": "~5.2.4",
    "expo-font": "~13.3.2",
    "expo-linking": "~7.1.7",
    "expo-router": "~5.1.11",
    "expo-splash-screen": "~0.30.10",
    "expo-status-bar": "~2.2.3",
    "expo-system-ui": "~5.0.11",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.6",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-track-player": "github:megamaxs1234/react-native-track-player#78bd5cfd48abfab98a7795610fa9c6dd9b7748f8",
    "react-native-web": "^0.20.0"
  },
  "jest": {
    "projects": [
      {
        "displayName": "web",
        "testEnvironment": "jsdom",
        "testMatch": [
          "<rootDir>/constants/__tests__/**/*.test.ts",
          "<rootDir>/utils/__tests__/**/*.test.ts",
          "<rootDir>/services/__tests__/**/*.test.ts",
          "<rootDir>/hooks/__tests__/**/*.test.ts"
        ],
        "transform": {
          "^.+\\.(ts|tsx|js|jsx)$": [
            "babel-jest",
            {
              "presets": [
                [
                  "babel-preset-expo",
                  {
                    "jsxRuntime": "automatic"
                  }
                ]
              ]
            }
          ]
        },
        "moduleNameMapper": {
          "\\.(png|jpg|jpeg|gif|webp|svg|m4a|mp3|wav|aac|ogg)$": "<rootDir>/__mocks__/asset-stub.js",
          "^@/(.*)$": "<rootDir>/$1"
        },
        "setupFiles": [
          "<rootDir>/jest.setup.ts"
        ]
      },
      {
        "displayName": "native",
        "preset": "jest-expo",
        "testMatch": [
          "<rootDir>/components/__tests__/**/*.test.tsx",
          "<rootDir>/app/__tests__/**/*.test.tsx"
        ],
        "moduleNameMapper": {
          "\\.(png|jpg|jpeg|gif|webp|svg|m4a|mp3|wav|aac|ogg)$": "<rootDir>/__mocks__/asset-stub.js",
          "^@/(.*)$": "<rootDir>/$1"
        }
      }
    ]
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.0.10",
    "babel-jest": "^30.3.0",
    "cross-env": "^10.1.0",
    "eas-cli": "^16.20.1",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~9.2.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.3.0",
    "jest-expo": "^53.0.14",
    "react-test-renderer": "^19.0.0",
    "typescript": "~5.8.3"
  }
}
